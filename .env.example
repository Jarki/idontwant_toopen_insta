OUTPUT_DIR='output'             # (OPTIONAL) Directory where videos will be downloaded
BOT_TOKEN=''                    # Telegram bot token
MAX_FILES=100                   # (OPTIONAL) Maximum number of files to keep in the output directory
TELEGRAM_MEDIA_WRITE_TIMEOUT=120 # (OPTIONAL) Upload timeout in seconds for large videos
TELEGRAM_READ_TIMEOUT=30         # (OPTIONAL) Telegram API response timeout in seconds
JUDGMENTAL_CHANCE=0.01          # (OPTIONAL) Probability (0.0–1.0) of a judgmental GIF response
                                # instead of downloading. 0=never, 0.01=1%, 0.05=5%, etc.
INSTAGRAM_REEL_DOWNLOADER_ENABLED=true # (OPTIONAL) Disabled downloaders ignore matching URLs
INSTAGRAM_POST_DOWNLOADER_ENABLED=true
TIKTOK_DOWNLOADER_ENABLED=true
REDDIT_DOWNLOADER_ENABLED=true
X_DOWNLOADER_ENABLED=true
YOUTUBE_DOWNLOADER_ENABLED=true
ERROR_LEDGER_ENABLED=true       # (OPTIONAL) Keep direct non-blocking ledger recording enabled
APP_RELEASE='development'       # Immutable image tag or commit SHA attached to ledger events
ERROR_REPORTER_QUEUE_SIZE=256   # (OPTIONAL) 1-256; events are dropped rather than blocking when full
ERROR_REPORTER_RETRIES=2        # (OPTIONAL) 0-2 retries in the reporter thread
ERROR_REPORTER_RETRY_BACKOFF_SECONDS=0.05 # (OPTIONAL) 0-0.05 seconds


# PostgreSQL — required for runtime and schema migrations
POSTGRES_DB='reels'                          # PostgreSQL database name
POSTGRES_USER='db_owner'                     # PostgreSQL bootstrap/owner user
POSTGRES_PASSWORD='change_me_bootstrap'      # PostgreSQL bootstrap/owner password

# Migration role (DDL-capable, schema owner)
DB_MIGRATION_USER='db_migration'
DB_MIGRATION_PASSWORD='change_me_migration'
DB_MIGRATION_URL='postgresql+psycopg://db_migration:change_me_migration@postgres:5432/reels'

# Application role (DML-only)
DB_APP_USER='db_app'
DB_APP_PASSWORD='change_me_app'
DATABASE_URL='postgresql+psycopg://db_app:change_me_app@postgres:5432/reels'

# Error API role (curated observability reads and triage writes only)
DB_ERROR_API_USER='db_error_api'
DB_ERROR_API_PASSWORD=''        # REQUIRED: generate a distinct random password
ERROR_API_DATABASE_URL=''       # REQUIRED: URL using DB_ERROR_API_USER/password

# Private Error API. Generate independent random values of at least 32 ASCII
# characters. Keep the *_NEXT pair empty until rotating that scope's key.
ERROR_API_READ_KEY=''           # REQUIRED: generate at least 32 random ASCII chars
ERROR_API_READ_LABEL='agent-read'
ERROR_API_READ_KEY_NEXT=''
ERROR_API_READ_LABEL_NEXT=''
ERROR_API_TRIAGE_KEY=''         # REQUIRED: generate a distinct random key
ERROR_API_TRIAGE_LABEL='agent-triage'
ERROR_API_TRIAGE_KEY_NEXT=''
ERROR_API_TRIAGE_LABEL_NEXT=''
ERROR_API_HOST_PORT=8000        # (OPTIONAL) Explicit override; prod defaults 8000, dev 8001
ERROR_API_STATEMENT_TIMEOUT_MS=3000 # (OPTIONAL) 100-30000

# bot-ops client configuration belongs on the operator/agent machine, not in
# the Compose deployment .env.
# ERROR_API_URL='https://errors.example-tailnet.ts.net'
# ERROR_API_KEY='replace_with_one_scoped_api_key'
